{
  "uid": "incident-desk",
  "title": "Incident Desk / Code Mode",
  "description": "NitroStack sandbox execution and a clearly separated synthetic incident evidence snapshot.",
  "tags": [
    "nitrostack",
    "code-mode",
    "incident-desk"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "graphTooltip": 1,
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "INCIDENT DESK / Code Mode observatory",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "**One investigation. Several tools. A bounded execution.**\n\nRuntime panels below come from real QuickJS executions. The evidence section uses a fixed, synthetic three-service snapshot. Generate activity with `npm run demo -- --traffic --include-failures`."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "01 / Execution overview",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Completed executions",
      "description": "Process-lifetime count, reset when the application restarts.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "incident-desk-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(incident_desk_runs_total)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "incident-desk-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "wideLayout": true
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Success",
      "description": "Process-lifetime fraction of completed executions. Blank until at least one run completes.",
      "gridPos": {
        "x": 5,
        "y": 4,
        "w": 5,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "incident-desk-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(incident_desk_runs_total{status=\"success\"}) / sum(incident_desk_runs_total)",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "incident-desk-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 90
              },
              {
                "color": "green",
                "value": 99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "wideLayout": true
      }
    },
