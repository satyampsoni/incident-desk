    {
      "id": 19,
      "type": "stat",
      "title": "Critical findings",
      "description": "Count in the latest successful canonical triage report; not the number of failed sandbox runs.",
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "incident-desk-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "incident_desk_triage_findings{severity=\"critical\"}",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "incident-desk-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
