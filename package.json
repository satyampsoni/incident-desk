{
  "name": "incident-desk",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/satyampsoni/incident-desk.git"
  },
  "description": "Read-only incident investigations with NitroStack Code Mode and observable sandbox execution.",
  "type": "module",
  "engines": { "node": "^22 || ^24 || >=26" },
  "scripts": {
    "postinstall": "node scripts/patch-nitrostack.mjs",
    "build": "tsc",
    "start": "node dist/src/main.js",
    "mcp": "node dist/src/main.js --stdio",
    "demo": "node scripts/demo.mjs",
    "test": "npm run build && node --test --test-concurrency=1 dist/test/*.test.js",
    "check": "npm test",
    "smoke:stack": "node scripts/verify-stack.mjs"
  },
  "dependencies": {
    "@nitrostack/core": "1.1.3",
    "@prometheus-io/client": "0.16.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@types/node": "22.15.30",
    "playwright": "1.65.1",
    "typescript": "5.9.3"
  }
}
